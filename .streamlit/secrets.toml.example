# Streamlit Cloud Secrets Configuration
# Copy this to the Streamlit Cloud dashboard under "Secrets"
# Do NOT commit secrets.toml to version control!

# FRED API Key (get free key at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY = "your_fred_api_key_here"

# Optional: Custom risk-free rate (default is 4.5%)
# RISK_FREE_RATE = 0.045

# Optional: Custom database URL (default is SQLite)
# DATABASE_URL = "sqlite:///portfolio.db"
