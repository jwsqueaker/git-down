# Copy this file to secrets.toml and add your actual credentials
# For Streamlit Cloud: Add these in the app settings under "Secrets"

# Required for Planet API access
PL_API_KEY = "your_planet_api_key_here"
PL_SERIES_NAME = "PlanetScope Weekly Basemap"

# Optional: AWS credentials for S3 delivery
AWS_BUCKET = "your-bucket-name"
AWS_PREFIX = "pothole-data/"
AWS_REGION = "us-west-2"
